{
  "name": "@mylomail/root",
  "version": "0.1.0",
  "description": "Private cross-platform desktop mail and calendar client",
  "author": "MyloMail contributors",
  "main": "apps/electron-shell/dist/Main.js",
  "desktopName": "MyloMail",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "watch": "tsx scripts/watch.ts",
    "status": "tsx scripts/status.ts",
    "format": "tsx scripts/format.ts write",
    "format:check": "tsx scripts/format.ts check",
    "check": "tsx scripts/check.ts full",
    "check:fast": "tsx scripts/check.ts fast",
    "check:deep": "tsx scripts/check.ts deep",
    "check:native-credentials": "tsx scripts/check.ts native",
    "check:platform": "tsx scripts/check.ts platform",
    "imap:up": "bash tests/imap-matrix/generate-cert.sh && docker compose -f tests/imap-matrix/compose.yaml up -d --wait",
    "imap:down": "docker compose -f tests/imap-matrix/compose.yaml down -v",
    "caldav:up": "bash tests/caldav-matrix/generate-cert.sh && docker compose -f tests/caldav-matrix/compose.yaml up -d --wait",
    "caldav:down": "docker compose -f tests/caldav-matrix/compose.yaml down -v",
    "generate:types": "tsx scripts/generate-types.ts",
    "build:electron": "tsx scripts/BuildElectron.ts",
    "app": "pnpm build:electron && MYLOMAIL_RENDERER_PATH=apps/renderer/dist electron apps/electron-shell/dist/Main.js",
    "pretest:e2e": "pnpm build:electron && dotnet build --nologo -v q server/MyloMail.Api/MyloMail.Api.csproj",
    "e2e": "pnpm pretest:e2e && playwright test --config tests/renderer.e2e/Playwright.config.ts",
    "e2e:attach": "pnpm pretest:e2e && playwright test --config tests/renderer.e2e/Attach.Playwright.config.ts",
    "package": "tsx scripts/Package.ts",
    "package:dir": "tsx scripts/Package.ts --dir",
    "package:smoke": "pnpm package:dir && playwright test --config tests/renderer.e2e/Packaged.Playwright.config.ts",
    "package:verify-artifacts": "tsx scripts/VerifyPackageArtifacts.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.35.0",
    "eslint-formatter-unix": "^8.40.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.3.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.5.3",
    "sass": "^1.103.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c"
}

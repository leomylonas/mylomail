{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "selector-class-pattern": [
      "^[a-z][a-zA-Z0-9]+$",
      {
        "message": "CSS Module class names are camelCase, so they are readable as `styles.messageRow` from TypeScript."
      }
    ],
    "custom-property-pattern": null,
    "declaration-property-value-no-unknown": true
  },
  "ignoreFiles": ["**/node_modules/**", "**/dist/**", "**/bin/**", "**/obj/**"]
}
